# Django Migrations - CAUTION: Only ignore if you manage migrations separately
# This prevents accidental migration commits between environments
# Uncomment if you want to ignore migration files
# backend/*/migrations/0*.py
# !backend/*/migrations/__init__.py

# Alternative: Only ignore specific migration patterns
# backend/*/migrations/*_initial.py
# backend/*/migrations/*_auto_*.py

